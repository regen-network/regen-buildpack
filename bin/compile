#!/usr/bin/env bash
# bin/compile <build-dir> <cache-dir>

set -e

# change to the the BUILD_DIR ($1)
cd $1
mkdir -p "$1/bin/"

echo "-----> Installing regen cli"

# download and install regen binary
curl -LO https://github.com/regen-network/regen-ledger/releases/download/v6.0.0-rc6/regen-ledger-6.0.0-rc6-linux-amd64.zip
echo "0019dfc4b32d63c1392aa264aed2253c1e0c2fb09216f8e2cc269bbfb8bb49b5  regen-ledger-6.0.0-rc6-linux-amd64.zip" | sha256sum -c
unzip regen-ledger-6.0.0-rc6-linux-amd64.zip
mv regen-ledger-6.0.0-rc6-linux-amd64/regen "$1/bin/regen"

echo "-----> Installing jq"

# download and install jq binary
curl -LO https://github.com/jqlang/jq/releases/download/jq-1.7.1/jq-linux-amd64
echo "5942c9b0934e510ee61eb3e30273f1b3fe2590df93933a93d7c58b81d19c8ff5  jq-linux-amd64" | sha256sum -c
mv jq-linux-amd64 "$1/bin/jq" 
chmod +x "$1/bin/jq"
