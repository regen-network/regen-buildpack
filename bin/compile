#!/usr/bin/env bash
# bin/compile <build-dir> <cache-dir>

set -e

# change to the the BUILD_DIR ($1)
cd $1
mkdir -p "$1/bin/"

echo "-----> Installing regen cli"

# download and install regen binary
curl -LO https://github.com/regen-network/regen-ledger/releases/download/v6.0.0/regen-ledger-6.0.0-linux-amd64
echo "c754afb2ae9e9f1e4e03aeecfa06536f47f8fa314f9bd58ca6ed54d0cf6f7ad9 regen-ledger-6.0.0-linux-amd64" | sha256sum -c
mv regen-ledger-6.0.0-linux-amd64 "$1/bin/regen"

echo "-----> Installing jq"

# download and install jq binary
curl -LO https://github.com/jqlang/jq/releases/download/jq-1.7.1/jq-linux-amd64
echo "5942c9b0934e510ee61eb3e30273f1b3fe2590df93933a93d7c58b81d19c8ff5  jq-linux-amd64" | sha256sum -c
mv jq-linux-amd64 "$1/bin/jq" 
chmod +x "$1/bin/jq"
